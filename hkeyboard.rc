// hkeyboard.rc
#include "resource.h"
#include <winres.h>

IDI_MAIN_ICON ICON "winres/main.ico"

IDR_FONT_REGULAR RCDATA "winres/AlibabaPuHuiTi-3-55-Regular.ttf"
IDR_FONT_BOLD    RCDATA "winres/AlibabaPuHuiTi-3-85-Bold.ttf"

// Win10 以下系统的图标字体（Segoe MDL2 Assets，系统未自带时由内嵌资源提供）
IDR_FONT_MDL2    RCDATA "winres/segmdl2.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "HKeyboard"
            VALUE "FileDescription", "HKeyboard - Screen Keyboard"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "HKeyboard"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 PanDaTech"
            VALUE "OriginalFilename", "HKeyboard.exe"
            VALUE "ProductName", "HKeyboard"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
